# Application
APP_NAME=ArchiveX
API_NAME=ArchiveX API
API_SERVICE_ID=archivex-api
API_VERSION=v1

# Server
PORT=5001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas (required for Phase 4 seed: npm run seed --prefix server)
MONGODB_URI=
MONGODB_DB_NAME=archivex

# Auth (Phase 6)
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Media (Phase 14) — local disk uploads served at /media
PUBLIC_ORIGIN=http://localhost:5001
MEDIA_UPLOAD_DIR=uploads
MEDIA_PUBLIC_PATH=/media
MEDIA_MAX_BYTES=5242880

# Client (Vite — prefix with VITE_)
VITE_APP_NAME=ArchiveX
VITE_APP_TAGLINE=Objects worth remembering.
VITE_API_BASE_URL=http://localhost:5001/api/v1
