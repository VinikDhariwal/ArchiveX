# Application
APP_NAME=ArchiveX
API_NAME=ArchiveX API
API_SERVICE_ID=archivex-api
API_VERSION=v1

# Server
PORT=5001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
# Comma-separated list allowed in production, e.g. https://archivex.example,https://www.archivex.example
# TRUST_PROXY=1

# MongoDB Atlas ONLY (required — API will not start without this)
# Atlas encrypts data at rest; passwords are bcrypt digests (never reversible ciphertext).
MONGODB_URI=
MONGODB_DB_NAME=archivex

# Auth (Phase 6 / 18)
JWT_ACCESS_SECRET=change-me-access-use-32plus-chars-in-prod
JWT_REFRESH_SECRET=change-me-refresh-use-32plus-chars-in-prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Rate limits (Phase 18) — disabled automatically when NODE_ENV=test
# RATE_LIMIT_ENABLED=true
RATE_LIMIT_API_MAX=300
RATE_LIMIT_AUTH_MAX=40

# Media (Phase 14) — Atlas GridFS for uploads; PUBLIC_ORIGIN for absolute image URLs
PUBLIC_ORIGIN=http://localhost:5001
MEDIA_MAX_BYTES=5242880

# Client (Vite — prefix with VITE_)
VITE_APP_NAME=ArchiveX
VITE_APP_TAGLINE=Objects worth remembering.
VITE_API_BASE_URL=http://localhost:5001/api/v1
